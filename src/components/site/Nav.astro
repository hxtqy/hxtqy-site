---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/', label: '首页', match: (p: string) => p === '/' },
  { href: '/about', label: '关于', match: (p: string) => p.startsWith('/about') },
  { href: '/writing', label: '写作', match: (p: string) => p.startsWith('/writing') },
  { href: '/projects', label: '项目', match: (p: string) => p.startsWith('/projects') },
];
---

<header class="site-nav" data-nav>
  <div class="shell site-nav__inner">
    <a class="wordmark" href="/" aria-label="hxtqy 首页">
      hxtqy<span class="wordmark__dot" aria-hidden="true"></span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.match(path) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <button
        class="icon-btn theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切换明暗主题"
        title="切换明暗主题"
      >
        <svg data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
        </svg>
        <svg data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
        </svg>
      </button>
    </nav>
  </div>
</header>
